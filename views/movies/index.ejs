<%- include('../partials/header') %>

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-film"></i> 
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Movies Collection' %>
    </h1>
    <% if (typeof currentGenre !== 'undefined') { %>
        <p class="page-subtitle">
            <a href="/movies" class="btn btn-outline btn-sm">
                <i class="fas fa-arrow-left"></i> All Movies
            </a>
        </p>
    <% } %>
    <% if (user) { %>
        <a href="/movies/add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Movie
        </a>
    <% } %>
</div>

<!-- Recommendations Section -->
<% if (user && typeof recommendations !== 'undefined' && recommendations.length > 0) { %>
    <div class="recommendations-section">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-magic"></i> Recommended for You
            </h2>
            <p class="section-subtitle">Based on your movie preferences</p>
        </div>
        
        <div class="movies-grid">
            <% recommendations.forEach(movie => { %>
                <div class="card movie-card recommendation-card">
                    <div class="recommendation-badge">
                        <i class="fas fa-star"></i> Recommended
                    </div>
                    <div class="card-body">
                        <h3 class="movie-title"><%= movie.name %></h3>
                        <div class="movie-meta">
                            <%= movie.year %> • <%= movie.director %>
                        </div>
                        <div class="movie-description">
                            <%= movie.description.substring(0, 100) %>...
                        </div>
                        <div class="genres">
                            <% movie.genres.forEach(genre => { %>
                                <a href="/movies/genre/<%= encodeURIComponent(genre) %>" class="badge genre-link">
                                    <%= genre %>
                                </a>
                            <% }) %>
                        </div>
                        <div class="rating">
                            <div class="rating-score">
                                <i class="fas fa-star"></i> <%= movie.rating %>/10
                            </div>
                            <div class="added-by">by <%= movie.addedBy.username %></div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/movies/<%= movie._id %>" class="btn btn-outline btn-sm">View Details</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
<% } %>

<!-- All Movies Section -->
<% if (typeof recommendations !== 'undefined' && recommendations.length > 0) { %>
    <div class="all-movies-section">
        <div class="section-header">
            <h2 class="section-title">
                <i class="fas fa-film"></i> All Movies
            </h2>
        </div>
    </div>
<% } %>

<% if (movies.length === 0) { %>
    <div class="empty-state">
        <i class="fas fa-film"></i>
        <h3>No <%= typeof currentGenre !== 'undefined' ? currentGenre.toLowerCase() : '' %> movies found</h3>
        <% if (user) { %>
            <a href="/movies/add" class="btn btn-primary mt-3">Add the first movie</a>
        <% } %>
    </div>
<% } else { %>
    <div class="movies-grid">
        <% movies.forEach(movie => { %>
            <div class="card movie-card">
                <div class="card-body">
                    <h3 class="movie-title"><%= movie.name %></h3>
                    <div class="movie-meta">
                        <%= movie.year %> • <%= movie.director %>
                    </div>
                    <div class="movie-description">
                        <%= movie.description.substring(0, 100) %>...
                    </div>
                    <div class="genres">
                        <% movie.genres.forEach(genre => { %>
                            <a href="/movies/genre/<%= encodeURIComponent(genre) %>" class="badge genre-link">
                                <%= genre %>
                            </a>
                        <% }) %>
                    </div>
                    <div class="rating">
                        <div class="rating-score">
                            <i class="fas fa-star"></i> <%= movie.rating %>/10
                        </div>
                        <div class="added-by">by <%= movie.addedBy.username %></div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="/movies/<%= movie._id %>" class="btn btn-outline btn-sm">View Details</a>
                    <% if (user && user._id === movie.addedBy._id.toString()) { %>
                        <a href="/movies/<%= movie._id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/footer') %>
