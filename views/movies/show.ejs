<%- include('../partials/header') %>

<div class="movie-details">
    <div class="card">
        <div class="card-header d-flex justify-between align-center">
            <h2><%= movie.name %></h2>
            <div class="rating-score">
                <i class="fas fa-star"></i> <%= movie.rating %>/10
            </div>
        </div>
        <div class="card-body">
            <div class="detail-row">
                <div class="detail-label">Year:</div>
                <div class="detail-value"><%= movie.year %></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Director:</div>
                <div class="detail-value"><%= movie.director %></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Genres:</div>
                <div class="detail-value">
                    <% movie.genres.forEach(genre => { %>
                        <span class="badge"><%= genre %></span>
                    <% }) %>
                </div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Description:</div>
                <div class="detail-value"><%= movie.description %></div>
            </div>
            <div class="detail-row">
                <div class="detail-label">Added by:</div>
                <div class="detail-value"><%= movie.addedBy.username %></div>
            </div>
        </div>
        <div class="card-footer">
            <div class="form-actions">
                <a href="/movies" class="btn btn-secondary">Back to Movies</a>
                <% if (user && user._id === movie.addedBy._id.toString()) { %>
                    <a href="/movies/<%= movie._id %>/edit" class="btn btn-warning">Edit Movie</a>
                    <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST" class="d-inline" 
                          onsubmit="return confirm('Are you sure you want to delete this movie?')">
                        <button type="submit" class="btn btn-danger">Delete Movie</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
